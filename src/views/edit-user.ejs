<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-user/<%= details.user_id %>" method="POST">
        <div class="form-group">
            <label for="name"><strong>Name: </strong></label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= details.name %>"
                required
            />
        </div>
        
        <div class="form-group">
            <label for="email"><strong>Email: </strong></label>
            <input
                type="email"
                id="email"
                name="email"
                value="<%= details.email %>"
                required
            />
        </div>

        <div class="form-group">
          <label for="role"><strong>Permission level: </strong></label>
          <input
            type="number"
            id="role"
            name="role"
            value="<%= details.role_id %>"
            required
          />
        </div>

        <div>
            <p><strong>Role: </strong> <%= details.role_name %></p>
        </div>

        <div>
            <p><strong>Date: </strong> <%= details.created_at.toISOString().split('T')[0] %></p>
        </div>

        <button type="submit">Update</button>
    </form>

</main>
<%- include('partials/footer') %>