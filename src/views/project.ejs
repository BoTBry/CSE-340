<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (isAdmin) { %>
        <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a>
        <a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a>
    <% } %>
    
    <% if (isLoggedIn && isVolunteer) { %>
        <p>You are volunteering for this project</p>
    <% } %>

    <% if (isLoggedIn && !isVolunteer) { %>
        <form action="/project/<%= projectDetails.project_id %>/volunteer" method="post">
            <button type="submit">volunteer</button>
        </form>
    <% } %>

    <p><strong>Description:</strong> <%= projectDetails.description %></p>

    <p><strong>Date:</strong> <%= projectDetails.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>

    <p><strong>Location:</strong> <%= projectDetails.location %></p>

    <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= projectDetails.organization_id %>">
            <%= projectDetails.organization_name %>
        </a>
    </p>

    <% categories.forEach(category => { %>
        <p><strong>category:</strong> <a href="/category/<%= category.category_id %>"><%= category.name %> </a></p>
    <% }); %>
</main>
<%- include('partials/footer') %>